{
  "name": "nzm-wiki",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "dev": "pnpm index && next dev",
    "build": "tsx scripts/build-static.ts",
    "start": "pnpm preview",
    "preview": "tsx scripts/preview-static.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --incremental false",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "test": "tsx --test scripts/**/*.test.ts",
    "content:validate": "tsx scripts/validate-content.ts",
    "webp": "pnpm exec tsx ./scripts/optimize-images.ts public/",
    "index": "tsx scripts/generate-search-index.ts"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "katex": "^0.16.28",
    "lucide-react": "^0.563.0",
    "next": "16.1.4",
    "next-mdx-remote": "^5.0.0",
    "pinyin-pro": "^3.28.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.7.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9",
    "eslint-config-next": "16.1.4",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "tsx": "^4",
    "typescript": "^5",
    "xlsx": "^0.18.5"
  }
}
